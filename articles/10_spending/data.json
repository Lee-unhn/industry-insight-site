  "honest_notes": [
    "銷售額原檔未標單位，以千元判讀並與經濟部餐飲營收核對",
    "財政部只公布到縣市，每店月均是全市平均，不是圈內實測",
    "三份資料年份不同；「餐廳及住宿」含住宿，只能近似外食"
  ],
  "method_notes": {
    "unit_basis": "原檔未標金額單位，以千元判讀，並對照經濟部全國餐飲營收",
    "tax_basis": "銷售額一般視為未稅，本篇不做稅額調整",
    "year_mismatch": "三份資料年份不同，銷售額、消費支出與店數不是同一年",
    "granularity": "財政部只公布到縣市，沒有行政區或距離圈的數字",
