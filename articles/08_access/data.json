  "method_notes": {
    "bus_note": "公車站牌座標僅在 TDX（運輸資料流通服務平臺）提供，需申請免費 API 金鑰（client_id/client_secret），屬人類關卡（D5 裁定）；本篇暫不含公車路網/站點，待金鑰到位後補",
    "parking_note": "資料為台南市公有停車場（付費＋免費，全市 408 筆），不含私有停車場/收費停車格，非市場全部車位供給",
    "youbike_note": "資料為抓取當下 YouBike 2.0 即時快照，只計入 act=='1'（目前在營運）站點；車柱總數(tot)/可借車數(sbi)會隨時間變動",
    "tra_note": "台鐵資料涵蓋 2023-01-01～2026-09-01（1340 天、4 個年度：2023-2025 為完整年，2026 年至今為部分年，資料只到 2026-09-01）；pipeline/tra_station.py 合併 data/parquet/tra_hist/（回補年）與 data/parquet/tra/（當年至今）產出的單站多年序列。圖 A 月度曲線、平日/假日日均、近 12 個月 vs 前 12 個月比較只用「完整月」（該月落地天數等於該月日曆天數），排除只有 1 天的 2026-09 部分月，避免部分月日均混進整月比較",
    "ring_use": {
      "5": "店家分析",
      "10": "居住人口",
      "15": "可及性參考（本篇主要圈）"
    },
    "isochrone_method": "OSMnx 本機路網計算（機車，剔除快速道路/高架橋），與篇①同一份 data/geo/isochrones.geojson",
    "sum_verification_gap_note": "停車位數、YouBike 車柱數兩類數字的原始欄位在 parquet 落地時型別是字串（非數值），check_numbers 的 sum 規則對字串欄位會直接失敗（DuckDB SUM(VARCHAR) 不支援），這兩類數字改用人工 duckdb（帶顯式轉型）與 pandas 交叉驗證，見任務回報；台鐵（tra_station）的兩個計數欄位已是 int64，不受此限，台鐵日均與加總數字全部改用 sum/ratio 規則接地",
    "osm_attribution": "地圖底圖（路網/等時圈邊界）重用篇①產出，© OpenStreetMap contributors (ODbL)",
