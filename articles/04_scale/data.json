  "method_notes": {
    "ring_scope": "資本額／組織別／連鎖占比以 5 分圈為主，另列全市（同業種）對照；分店占比另列 10／15 分",
    "capital_buckets": "以登記資本額分箱（新台幣）：≤10萬／10-50萬／50-200萬／200-1000萬／>1000萬；資本額為 0 或無法判讀者計入「未登記」，不納入分箱與中位數",
    "capital_unregistered_note": "分支機構（見下）多數登記資本額為 0（資本歸總公司），故「未登記」比例會偏高，屬正常現象，非資料缺失",
    "org_type_buckets": "沿用篇①桶法：公司（股份有限公司／本國或外國公司之分公司或辦事處）／有限公司／獨資／其他（合夥／合作社／有限合夥）",
    "branch_definition": "以稅籍登記的母公司代碼欄位是否非空，判定該店是否為分支機構（連鎖／分店）；欄位非空即計為分店",
    "same_name_chain_definition": "近似連鎖估計：同一營業人名稱在同一範圍內出現 >= 3 次的群組，只計群組數與群組內店數合計，不輸出名稱本身；與母公司代碼判準是兩種獨立估計，可能重疊",
    "founding_year_definition": "設立日期為民國年月日 7 位數字，年份 = 民國年 + 1911",
    "recent_years_definition": "「近 5 年新開店」= 設立年份 >= 資料年度 - 4（資料年度 2026，即 2022-2026）",
    "data_version": "2026-09-08"
  }
